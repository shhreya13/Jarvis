{
  "name": "@jarvis/skills",
  "version": "0.1.0",
  "description": "Jarvis skill system: manifest loader, permission enforcement, hot reload",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
