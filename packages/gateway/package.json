{
  "name": "@jarvis/gateway",
  "version": "0.1.0",
  "description": "Jarvis daemon: REST + websocket gateway, Telegram, scheduler",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
