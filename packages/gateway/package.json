  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/websocket": "^11.0.0",
    "@jarvis/core": "workspace:*",
    "@jarvis/skills": "workspace:*",
    "@jarvis/tools": "workspace:*",
    "croner": "^9.0.0",
    "fastify": "^5.0.0",
    "grammy": "^1.30.0",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
